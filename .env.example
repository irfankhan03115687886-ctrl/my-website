# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will never be committed or
# uploaded anywhere. Never share these values in chat, email, or a public repo.

# --- Database (Supabase or Neon — see README.md) ---
# Use the "pooled" / "pgbouncer" connection string if your provider offers one.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# --- Stripe (see README.md) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# Configure ONE of the two options below. If neither is set, emails are
# just logged to the console — fine for local dev, but customers won't
# receive anything until one of these is filled in.
#
# Option A — Resend (recommended, especially if you deploy to Vercel or
# any other serverless host: those platforms commonly block outbound
# SMTP ports, which makes Option B silently fail there). Get a free API
# key at https://resend.com/api-keys — no domain verification required
# to start, `onboarding@resend.dev` works immediately for testing.
RESEND_API_KEY=
RESEND_FROM="Field & Co <onboarding@resend.dev>"

# Option B — SMTP (nodemailer). Works with Gmail (use an App Password,
# not your normal password), Outlook/Office365, SendGrid's SMTP relay,
# Mailgun's SMTP relay, Amazon SES SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Field & Co <no-reply@yourdomain.com>"
# Optional: internal address that gets notified when a customer submits
# the Contact form. Leave unset to skip the notification email — messages
# are always saved to the database and visible at /admin/contact-messages
# either way.
CONTACT_NOTIFY_EMAIL=

# --- Site URL ---
# Your real domain once deployed, e.g. https://fieldandco.com
# Used in metadata, the sitemap, and Stripe's success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Image storage (optional, but required if you deploy to a serverless
# host like Vercel — its filesystem is read-only, so product photo /
# avatar / hero uploads need real object storage there. See
# lib/storage.js for full setup notes per provider (AWS S3, Cloudflare
# R2, DigitalOcean Spaces, Backblaze B2, MinIO all work). Leave these
# unset for local development — uploads just go to public/uploads/. ---
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=           # only needed for non-AWS providers, e.g. R2/Spaces
# S3_PUBLIC_URL_BASE=    # public URL your bucket is served from, if not AWS's default
